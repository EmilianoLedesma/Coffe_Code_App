{
  "info": {
    "name": "🔥 Fuego - Rol Cocinero",
    "description": "Bateria de prueba de fuego para el rol Cocinero: CRUD de catalogo/inventario, validacion en 3 capas del ajuste de stock (esquema, regla de negocio, existencia) y cruces de rol hacia compras/admin/reportes. Incluye limpieza final para no dejar residuos.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8010"
    },
    {
      "key": "token_cocinero",
      "value": ""
    },
    {
      "key": "id_categoria",
      "value": "1"
    },
    {
      "key": "ingrediente_id",
      "value": "1"
    },
    {
      "key": "producto_id_prueba",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "00 - Autenticacion",
      "item": [
        {
          "name": "Login Cocinero",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo_electronico\": \"cocinero@coffeecode.com\",\n  \"password\": \"Cocinero123!\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "(function () {",
                  "  const data = pm.response.json();",
                  "  pm.collectionVariables.set('token_cocinero', data.access_token);",
                  "  pm.test('login exitoso (200)', () => pm.response.code === 200);",
                  "})();"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "01 - Flujo legitimo: catalogo",
      "item": [
        {
          "name": "Listar Productos",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/productos",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "productos"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token_cocinero}}"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "(function () {",
                  "  pm.test('200 OK', () => pm.response.code === 200);",
                  "})();"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Crear Producto de prueba",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{base_url}}/productos",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "productos"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token_cocinero}}"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Producto Prueba de Fuego\",\n  \"descripcion\": \"creado por la coleccion de fuego, se elimina al final\",\n  \"precio_venta\": 30,\n  \"disponible\": true,\n  \"activo\": true,\n  \"id_categoria\": \"{{id_categoria}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "(function () {",
                  "  const data = pm.response.json();",
                  "  if (data.id) { pm.collectionVariables.set('producto_id_prueba', data.id); }",
                  "  pm.test('producto creado (201)', () => pm.response.code === 201);",
                  "})();"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Editar Producto de prueba",
          "request": {
            "method": "PUT",
            "url": {
              "raw": "{{base_url}}/productos/{{producto_id_prueba}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "productos",
                "{{producto_id_prueba}}"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token_cocinero}}"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"precio_venta\": 32\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "(function () {",
                  "  pm.test('200 OK', () => pm.response.code === 200);",
                  "})();"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "02 - Flujo legitimo: inventario",
      "item": [
        {
          "name": "Listar Ingredientes",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/ingredientes",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "ingredientes"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token_cocinero}}"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "(function () {",
                  "  pm.test('200 OK', () => pm.response.code === 200);",
                  "})();"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Ajustar Stock (delta correcto +50)",
          "request": {
            "method": "PUT",
            "url": {
              "raw": "{{base_url}}/ingredientes/{{ingrediente_id}}/stock",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "ingredientes",
                "{{ingrediente_id}}",
                "stock"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token_cocinero}}"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cantidad\": \"50\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "(function () {",
                  "  pm.test('200 OK', () => pm.response.code === 200);",
                  "})();"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "03 - Errores esperados: ajuste de stock invalido",
      "item": [
        {
          "name": "[ERROR] Ajuste sin campo cantidad",
          "request": {
            "method": "PUT",
            "url": {
              "raw": "{{base_url}}/ingredientes/{{ingrediente_id}}/stock",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "ingredientes",
                "{{ingrediente_id}}",
                "stock"
              ]
            },
            "description": "Falta el campo requerido 'cantidad'. Se espera 422 de validacion.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token_cocinero}}"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "(function () {",
                  "  pm.test('rechazado (422)', () => pm.response.code === 422);",
                  "})();"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "[ERROR] Ajuste con valor no numerico",
          "request": {
            "method": "PUT",
            "url": {
              "raw": "{{base_url}}/ingredientes/{{ingrediente_id}}/stock",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "ingredientes",
                "{{ingrediente_id}}",
                "stock"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token_cocinero}}"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cantidad\": \"no-es-un-numero\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "(function () {",
                  "  pm.test('rechazado (422)', () => pm.response.code === 422);",
                  "})();"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "[ERROR] Delta deja el stock en negativo",
          "request": {
            "method": "PUT",
            "url": {
              "raw": "{{base_url}}/ingredientes/{{ingrediente_id}}/stock",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "ingredientes",
                "{{ingrediente_id}}",
                "stock"
              ]
            },
            "description": "Delta deliberadamente enorme y negativo para garantizar stock_actual + cantidad < 0 sin importar el stock actual. Se espera 409.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token_cocinero}}"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cantidad\": -999999999\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "(function () {",
                  "  pm.test('rechazado (409)', () => pm.response.code === 409);",
                  "})();"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "[ERROR] Ingrediente inexistente",
          "request": {
            "method": "PUT",
            "url": {
              "raw": "{{base_url}}/ingredientes/999999/stock",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "ingredientes",
                "999999",
                "stock"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token_cocinero}}"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cantidad\": \"10\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "(function () {",
                  "  pm.test('no encontrado (404)', () => pm.response.code === 404);",
                  "})();"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "04 - Errores esperados: cruce de rol",
      "item": [
        {
          "name": "[ERROR] Registrar compra de insumo (rol Caja)",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{base_url}}/compras",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "compras"
              ]
            },
            "description": "POST /compras es exclusivo de Cajero/Administrador. Se espera 401/403.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token_cocinero}}"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ingrediente_id\": \"{{ingrediente_id}}\",\n  \"cantidad\": 100,\n  \"monto\": 50\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "(function () {",
                  "  pm.test('bloqueado (401/403)', () => [401, 403].includes(pm.response.code));",
                  "})();"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "[ERROR] Acceso a modulo Admin",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/usuarios",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "usuarios"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token_cocinero}}"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "(function () {",
                  "  pm.test('bloqueado (401/403)', () => [401, 403].includes(pm.response.code));",
                  "})();"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "[ERROR] Acceso a reportes financieros",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/reportes/financiero",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "reportes",
                "financiero"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token_cocinero}}"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "(function () {",
                  "  pm.test('bloqueado (401/403)', () => [401, 403].includes(pm.response.code));",
                  "})();"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "05 - Limpieza",
      "item": [
        {
          "name": "Eliminar Producto de prueba (soft delete)",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{base_url}}/productos/{{producto_id_prueba}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "productos",
                "{{producto_id_prueba}}"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token_cocinero}}"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "(function () {",
                  "  pm.test('eliminado (200/204)', () => [200, 204].includes(pm.response.code));",
                  "})();"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Revertir ajuste de stock (-50)",
          "request": {
            "method": "PUT",
            "url": {
              "raw": "{{base_url}}/ingredientes/{{ingrediente_id}}/stock",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "ingredientes",
                "{{ingrediente_id}}",
                "stock"
              ]
            },
            "description": "Revierte el ajuste +50 hecho en '01 - Flujo legitimo: inventario' para dejar el stock como estaba.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token_cocinero}}"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cantidad\": \"-50\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "(function () {",
                  "  pm.test('200 OK', () => pm.response.code === 200);",
                  "})();"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    }
  ]
}
