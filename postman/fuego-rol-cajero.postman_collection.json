        {
          "name": "Crear Pedido (setup)",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{base_url}}/pedidos",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "pedidos"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token_mesero_setup}}"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mesa_id\": \"{{mesa_id}}\",\n  \"usuario_id\": \"{{usuario_id_mesero}}\",\n  \"items\": [\n    {\n      \"id_producto\": \"{{producto_id}}\",\n      \"cantidad\": 1\n    }\n  ]\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "(function () {",
                  "  const data = pm.response.json();",
                  "  if (data.id) { pm.collectionVariables.set('pedido_id_setup', data.id); }",
                  "  pm.test('pedido creado (201)', () => { if (!(pm.response.code === 201)) { throw new Error('pedido creado (201) -- assertion failed (status ' + pm.response.code + ')'); } });",
                  "})();"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
