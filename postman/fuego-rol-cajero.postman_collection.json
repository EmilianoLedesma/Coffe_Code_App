{
  "info": {
    "name": "Fuego - Rol Cajero",
    "description": "Bateria de prueba de fuego para el rol Cajero: gasto y compra reales con incremento atomico de stock, venta valida con bloqueo de pago duplicado, validacion de compras corruptas, y cruces de rol hacia cocina/admin/corte-diario. Incluye un setup con Mesero para tener un pedido que vender.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8010"
    },
    {
      "key": "token_cajero",
      "value": ""
    },
    {
      "key": "token_mesero_setup",
      "value": ""
    },
    {
      "key": "ingrediente_id",
      "value": "1"
    },
    {
      "key": "mesa_id",
      "value": "6"
    },
    {
      "key": "usuario_id_mesero",
      "value": "2"
    },
    {
      "key": "producto_id",
      "value": "1"
    },
    {
      "key": "pedido_id_setup",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "00 - Autenticacion",
      "item": [
        {
          "name": "Login Cajero",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo_electronico\": \"cajero@coffeecode.com\",\n  \"password\": \"Cajero123!\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "(function () {",
                  "  const data = pm.response.json();",
                  "  pm.collectionVariables.set('token_cajero', data.access_token);",
                  "  pm.test('login exitoso (200)', () => { if (!(pm.response.code === 200)) { throw new Error('login exitoso (200) -- assertion failed (status ' + pm.response.code + ')'); } });",
                  "})();"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
