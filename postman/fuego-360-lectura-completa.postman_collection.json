    {
      "name": "07 - Cortes diarios (lectura, con 1 setup)",
      "item": [
        {
          "name": "Generar corte de hoy (setup necesario para poder consultarlo)",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{base_url}}/api/cortes-diarios",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "cortes-diarios"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token_admin}}"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "(function () {",
                  "  pm.expect(pm.response.code).to.eql(200);",
                  "  const data = pm.response.json();",
                  "  pm.expect(data).to.have.property('fecha');",
                  "  pm.collectionVariables.set('fecha_hoy', data.fecha);",
                  "})();"
                ]
              }
            }
          ]
        },
        {
          "name": "Listar Cortes Diarios (rango)",
