{
  "info": {
    "name": "🔥 Fuego - Flujo Pedido Completo (con errores)",
    "description": "Ciclo de vida real de un pedido de punta a punta -- Mesero crea, Cocina prepara, Caja cobra, Mesero entrega -- con 3 errores deliberados intercalados antes de cada paso correcto (transicion invalida, monto insuficiente, pago duplicado). Ejecutar en orden con el Collection Runner. Verifica ademas que la mesa pasa a Ocupada al crear el pedido y vuelve a Libre al entregarlo.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8010"
    },
    {
      "key": "token_mesero",
      "value": ""
    },
    {
      "key": "token_cocinero",
      "value": ""
    },
    {
      "key": "token_cajero",
      "value": ""
    },
    {
      "key": "mesa_id",
      "value": "4"
    },
    {
      "key": "usuario_id_mesero",
      "value": "2"
    },
    {
      "key": "producto_id",
      "value": "4"
    },
    {
      "key": "producto_id_2",
      "value": "9"
    },
    {
      "key": "pedido_id",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "00 - Autenticacion (los 3 roles operativos)",
      "item": [
        {
          "name": "Login Mesero",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo_electronico\": \"mesero@coffeecode.com\",\n  \"password\": \"Mesero123!\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "(function () {",
                  "  const data = pm.response.json();",
                  "  pm.collectionVariables.set('token_mesero', data.access_token);",
                  "  pm.test('200 OK', () => pm.response.code === 200);",
                  "})();"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Login Cocinero",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo_electronico\": \"cocinero@coffeecode.com\",\n  \"password\": \"Cocinero123!\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "(function () {",
                  "  const data = pm.response.json();",
                  "  pm.collectionVariables.set('token_cocinero', data.access_token);",
                  "  pm.test('200 OK', () => pm.response.code === 200);",
                  "})();"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Login Cajero",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo_electronico\": \"cajero@coffeecode.com\",\n  \"password\": \"Cajero123!\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "(function () {",
                  "  const data = pm.response.json();",
                  "  pm.collectionVariables.set('token_cajero', data.access_token);",
                  "  pm.test('200 OK', () => pm.response.code === 200);",
                  "})();"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "01 - Mesero crea el pedido",
      "item": [
        {
          "name": "Crear Pedido",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{base_url}}/pedidos",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "pedidos"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token_mesero}}"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mesa_id\": \"{{mesa_id}}\",\n  \"usuario_id\": \"{{usuario_id_mesero}}\",\n  \"items\": [\n    {\n      \"id_producto\": \"{{producto_id}}\",\n      \"cantidad\": 2\n    },\n    {\n      \"id_producto\": \"{{producto_id_2}}\",\n      \"cantidad\": 1\n    }\n  ]\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "(function () {",
                  "  const data = pm.response.json();",
                  "  if (data.id) { pm.collectionVariables.set('pedido_id', data.id); }",
                  "  pm.test('pedido creado (201)', () => pm.response.code === 201);",
                  "  pm.test('estatus inicial Pendiente', () => data.estatus.nombre === 'Pendiente');",
                  "})();"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Verificar mesa Ocupada",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/mesas",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "mesas"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token_mesero}}"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "(function () {",
                  "  const data = pm.response.json();",
                  "  const mesaId = parseInt(pm.collectionVariables.get('mesa_id'));",
                  "  const mesa = data.find((m) => m.id === mesaId);",
                  "  pm.test('mesa marcada Ocupada', () => mesa && mesa.estatus.nombre === 'Ocupada');",
                  "})();"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "02 - Cocina: transicion invalida (error esperado)",
      "item": [
        {
          "name": "[ERROR] Saltar de Pendiente a Listo",
          "request": {
            "method": "PUT",
            "url": {
              "raw": "{{base_url}}/pedidos/{{pedido_id}}/estado",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "pedidos",
                "{{pedido_id}}",
                "estado"
              ]
            },
            "description": "Cocina apurada intenta saltarse 'En preparacion'. Se espera 409.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token_cocinero}}"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"estatus\": \"Listo\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "(function () {",
                  "  pm.test('transicion rechazada (409)', () => pm.response.code === 409);",
                  "})();"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
