{
  "info": {
    "name": "🔥 Fuego - Rol Administrador",
    "description": "Bateria de prueba de fuego para el rol Administrador: alta/baja de usuarios y categorias, reset de password, reportes JSON/PDF/XLSX, corte diario, y verificacion de que otros roles NO pueden tocar estos endpoints exclusivos. Nota: el rechazo del panel web-admin a un no-administrador se prueba manualmente via POST http://127.0.0.1:8020/login (Flask), no via esta coleccion de API.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8010"
    },
    {
      "key": "token_admin",
      "value": ""
    },
    {
      "key": "token_cajero_setup",
      "value": ""
    },
    {
      "key": "id_rol_mesero",
      "value": "1"
    },
    {
      "key": "usuario_id_prueba",
      "value": ""
    },
    {
      "key": "categoria_id_prueba",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "00 - Autenticacion",
      "item": [
        {
          "name": "Login Admin",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo_electronico\": \"admin@coffeecode.com\",\n  \"password\": \"Admin123!\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "(function () {",
                  "  const data = pm.response.json();",
                  "  pm.collectionVariables.set('token_admin', data.access_token);",
                  "  pm.test('login exitoso (200)', () => pm.response.code === 200);",
                  "})();"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "01 - Usuarios",
      "item": [
        {
          "name": "Crear Usuario de prueba",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{base_url}}/api/usuarios",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "usuarios"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token_admin}}"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Test\",\n  \"apellido_paterno\": \"Fuego\",\n  \"correo_electronico\": \"test.fuego.postman@coffeecode.com\",\n  \"password\": \"TestFuego123!\",\n  \"id_rol\": \"{{id_rol_mesero}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "(function () {",
                  "  const data = pm.response.json();",
                  "  if (data.id) { pm.collectionVariables.set('usuario_id_prueba', data.id); }",
                  "  pm.test('usuario creado (201)', () => pm.response.code === 201);",
                  "})();"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Verificar login del usuario nuevo",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo_electronico\": \"test.fuego.postman@coffeecode.com\",\n  \"password\": \"TestFuego123!\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "(function () {",
                  "  pm.test('login exitoso (200)', () => pm.response.code === 200);",
                  "})();"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Reset de password del usuario de prueba",
          "request": {
            "method": "PUT",
            "url": {
              "raw": "{{base_url}}/api/usuarios/{{usuario_id_prueba}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "usuarios",
                "{{usuario_id_prueba}}"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token_admin}}"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"password\": \"TestFuegoNueva456!\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "(function () {",
                  "  pm.test('200 OK', () => pm.response.code === 200);",
                  "})();"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Desactivar Usuario de prueba",
          "request": {
            "method": "PUT",
            "url": {
              "raw": "{{base_url}}/api/usuarios/{{usuario_id_prueba}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "usuarios",
                "{{usuario_id_prueba}}"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token_admin}}"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"activo\": false\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "(function () {",
                  "  pm.test('200 OK', () => pm.response.code === 200);",
                  "})();"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "[ERROR] Login de usuario ya desactivado",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Un usuario desactivado no debe poder autenticarse. Se espera 401.",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo_electronico\": \"test.fuego.postman@coffeecode.com\",\n  \"password\": \"TestFuegoNueva456!\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "(function () {",
                  "  pm.test('rechazado (401)', () => pm.response.code === 401);",
                  "})();"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
