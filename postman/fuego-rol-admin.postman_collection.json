    {
      "name": "05 - Errores esperados: proteccion de endpoints exclusivos de Admin",
      "item": [
        {
          "name": "Login Cajero (setup)",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo_electronico\": \"cajero@coffeecode.com\",\n  \"password\": \"Cajero123!\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "(function () {",
                  "  const data = pm.response.json();",
                  "  pm.collectionVariables.set('token_cajero_setup', data.access_token);",
                  "  pm.test('login exitoso (200)', () => pm.response.code === 200);",
                  "})();"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "[ERROR] Cajero intenta generar Corte Diario",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{base_url}}/api/cortes-diarios",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "cortes-diarios"
              ]
            },
            "description": "El corte diario es exclusivo de Administrador. Se espera 401/403.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token_cajero_setup}}"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "(function () {",
                  "  pm.test('bloqueado (401/403)', () => [401, 403].includes(pm.response.code));",
                  "})();"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "[ERROR] Cajero intenta ver usuarios",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/usuarios",
              "host": [
                "{{base_url}}"
