    {
      "name": "00 - Autenticacion",
      "item": [
        {
          "name": "Login Admin",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo_electronico\": \"admin@coffeecode.com\",\n  \"password\": \"Admin123!\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "(function () {",
                  "  const data = pm.response.json();",
                  "  pm.collectionVariables.set('token_admin', data.access_token);",
                  "  pm.test('login exitoso (200)', () => { if (!(pm.response.code === 200)) { throw new Error('login exitoso (200) -- assertion failed (status ' + pm.response.code + ')'); } });",
                  "})();"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
